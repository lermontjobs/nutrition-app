generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  password            String
  name                String
  dateOfBirth         DateTime?
  gender              String?
  height              Float?
  isAdmin             Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  goals               UserGoals?
  dietaryPreferences  DietaryPreferences?
  foodLogs            FoodLog[]
  bodyMeasurements    BodyMeasurement[]
  waterLogs           WaterLog[]
  dailyPlans          DailyPlan[]
  aIConversation      AIConversation[]
  weeklyPlans         WeeklyPlan[]
}

model UserGoals {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalType             String   @default("maintain")
  currentWeight        Float?
  targetWeight         Float?
  dailyCalories        Int      @default(2000)
  dailyProtein         Float    @default(150)
  dailyCarbs           Float    @default(200)
  dailyFat             Float    @default(65)
  dailyWater           Float    @default(2.5)
  mealsPerDay          Int      @default(4)
  activityLevel        String   @default("moderate")
  weeklyWeightLossGoal Float?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model DietaryPreferences {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isKosher    Boolean  @default(false)
  isVegetarian Boolean @default(false)
  isVegan     Boolean  @default(false)
  allergies   String?
  dislikes    String?
  favorites   String?
  maxPrepTime Int      @default(30)
  medicalNotes String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Food {
  id          String      @id @default(cuid())
  name        String
  category    String      @default("general")
  calories    Float
  protein     Float       @default(0)
  carbs       Float       @default(0)
  fat         Float       @default(0)
  fiber       Float       @default(0)
  servingSize Float       @default(100)
  isVerified  Boolean     @default(false)
  createdAt   DateTime    @default(now())
  mealItems   MealItem[]
  foodLogs    FoodLog[]
}

model Meal {
  id             String          @id @default(cuid())
  name           String
  mealType       String          @default("custom")
  totalCalories  Float           @default(0)
  totalProtein   Float           @default(0)
  totalCarbs     Float           @default(0)
  totalFat       Float           @default(0)
  instructions   String?
  prepTime       Int?
  imageUrl       String?
  isPublic       Boolean         @default(false)
  createdAt      DateTime        @default(now())
  items          MealItem[]
  dailyPlanMeals DailyPlanMeal[]
  weeklyPlanMeals WeeklyPlanMeal[]
}

model MealItem {
  id       String @id @default(cuid())
  mealId   String
  meal     Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)
  foodId   String
  food     Food   @relation(fields: [foodId], references: [id], onDelete: Cascade)
  quantity Float
  unit     String @default("g")
}

model DailyPlan {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime
  totalCalories Float           @default(0)
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  meals         DailyPlanMeal[]
}

model DailyPlanMeal {
  id               String   @id @default(cuid())
  planId           String
  plan             DailyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  mealId           String
  meal             Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  mealType         String
  order            Int      @default(0)
  isEaten          Boolean  @default(false)
  isReplaced       Boolean  @default(false)
  replacedByMealId String?
}

model FoodLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodId    String?
  food      Food?    @relation(fields: [foodId], references: [id], onDelete: SetNull)
  date      DateTime
  mealType  String   @default("snack")
  quantity  Float
  unit      String   @default("g")
  calories  Float
  protein   Float    @default(0)
  carbs     Float    @default(0)
  fat       Float    @default(0)
  notes     String?
  createdAt DateTime @default(now())
}

model BodyMeasurement {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime
  weight       Float?
  bodyFat      Float?
  muscleMass   Float?
  waist        Float?
  belly        Float?
  chest        Float?
  hip          Float?
  arm          Float?
  steps        Int?
  sleepHours   Float?
  water        Float?
  hungerLevel  Int?
  energyLevel  Int?
  mood         Int?
  workouts     Int?
  adherencePct Int?
  notes        String?
  createdAt    DateTime @default(now())
}

model WaterLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  amount    Float
  createdAt DateTime @default(now())
}

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt DateTime @default(now())
  messages  String   @default("[]")
}

model WeeklyPlan {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart DateTime
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  meals     WeeklyPlanMeal[]
}

model WeeklyPlanMeal {
  id             String      @id @default(cuid())
  planId         String
  plan           WeeklyPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  dayOfWeek      Int
  mealType       String
  mealId         String?
  meal           Meal?       @relation(fields: [mealId], references: [id])
  customMealName String?
  calories       Float?
  protein        Float?
}
