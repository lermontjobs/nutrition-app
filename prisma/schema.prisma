generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = env("DATABASE_PROVIDER")
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String
  dateOfBirth   DateTime?
  gender        String?
  height        Float?
  isAdmin       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  goals              UserGoals?
  dietaryPreferences DietaryPreferences?
  dailyPlans         DailyPlan[]
  foodLogs           FoodLog[]
  bodyMeasurements   BodyMeasurement[]
  waterLogs          WaterLog[]
  activityLogs       ActivityLog[]
  aiConversations    AIConversation[]
  customFoods        Food[]
  weeklyPlans        WeeklyPlan[]
  progressPhotos     ProgressPhoto[]
}

model UserGoals {
  id                String   @id @default(cuid())
  userId            String   @unique
  currentWeight     Float?
  targetWeight      Float?
  goalType          String   @default("lose") // lose, maintain, gain, muscle, composition
  activityLevel     String   @default("moderate") // sedentary, light, moderate, active, very_active
  workoutsPerWeek   Int      @default(3)
  workoutTypes      String   @default("")
  targetDate        DateTime?
  dailyCalories     Int      @default(2000)
  dailyProtein      Int      @default(150)
  dailyCarbs        Int      @default(200)
  dailyFat          Int      @default(65)
  dailyWater        Float    @default(2.5)
  mealsPerDay       Int      @default(4)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DietaryPreferences {
  id                String   @id @default(cuid())
  userId            String   @unique
  isKosher          Boolean  @default(false)
  isVegetarian      Boolean  @default(false)
  isVegan           Boolean  @default(false)
  meatPreference    String   @default("all") // meat, dairy, pareve, all
  allergies         String   @default("") // comma separated
  dislikes          String   @default("")
  favorites         String   @default("")
  medicalNotes      String   @default("")
  maxPrepTime       Int      @default(30)
  weeklyBudget      Float?
  preferHome        Boolean  @default(true)
  preferRestaurant  Boolean  @default(false)
  preferReady       Boolean  @default(false)
  mealTimes         String   @default("") // JSON
  workoutTimes      String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Food {
  id            String   @id @default(cuid())
  name          String
  nameEn        String?
  brand         String?
  servingSize   Float    @default(100)
  unit          String   @default("g")
  calories      Float
  protein       Float
  carbs         Float
  fat           Float
  fiber         Float?
  sodium        Float?
  isEstimated   Boolean  @default(false)
  source        String   @default("manual")
  category      String   @default("general")
  userId        String?  // null = global food
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user      User?      @relation(fields: [userId], references: [id])
  mealItems MealItem[]
  foodLogs  FoodLog[]
}

model Meal {
  id           String   @id @default(cuid())
  name         String
  mealType     String   @default("custom") // breakfast, morning_snack, lunch, afternoon_snack, dinner, pre_workout, post_workout, custom
  instructions String?
  prepTime     Int?
  isFavorite   Boolean  @default(false)
  isAISuggested Boolean @default(false)
  totalCalories Float   @default(0)
  totalProtein  Float   @default(0)
  totalCarbs    Float   @default(0)
  totalFat      Float   @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items          MealItem[]
  dailyPlanMeals DailyPlanMeal[]
  weeklyPlanMeals WeeklyPlanMeal[]
}

model MealItem {
  id       String @id @default(cuid())
  mealId   String
  foodId   String
  quantity Float
  unit     String @default("g")

  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)
  food Food @relation(fields: [foodId], references: [id])
}

model DailyPlan {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  meals DailyPlanMeal[]

  @@unique([userId, date])
}

model DailyPlanMeal {
  id          String   @id @default(cuid())
  dailyPlanId String
  mealId      String
  mealType    String
  plannedTime String?
  status      String   @default("planned") // planned, eaten_full, eaten_partial, skipped, replaced
  portionPct  Float    @default(100)
  order       Int      @default(0)

  dailyPlan DailyPlan @relation(fields: [dailyPlanId], references: [id], onDelete: Cascade)
  meal      Meal      @relation(fields: [mealId], references: [id])
}

model FoodLog {
  id        String   @id @default(cuid())
  userId    String
  foodId    String
  date      DateTime
  mealType  String
  quantity  Float
  unit      String   @default("g")
  calories  Float
  protein   Float
  carbs     Float
  fat       Float
  notes     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  food Food @relation(fields: [foodId], references: [id])
}

model BodyMeasurement {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime
  weight      Float?
  bodyFat     Float?
  muscleMass  Float?
  waist       Float?
  belly       Float?
  chest       Float?
  hip         Float?
  arm         Float?
  steps       Int?
  sleepHours  Float?
  water       Float?
  workouts    Int?
  hungerLevel Int?
  energyLevel Int?
  mood        Int?
  adherencePct Float?
  notes       String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model WaterLog {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  amount    Float
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  type      String
  duration  Int?
  calories  Int?
  notes     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @default(now())
  messages  String   // JSON array
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  suggestions AIMealSuggestion[]
}

model AIMealSuggestion {
  id             String   @id @default(cuid())
  conversationId String
  mealData       String   // JSON
  isApproved     Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model WeeklyPlan {
  id        String   @id @default(cuid())
  userId    String
  weekStart DateTime
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  meals WeeklyPlanMeal[]

  @@unique([userId, weekStart])
}

model WeeklyPlanMeal {
  id           String @id @default(cuid())
  weeklyPlanId String
  mealId       String
  dayOfWeek    Int    // 0=Sunday, 6=Saturday
  mealType     String
  order        Int    @default(0)

  weeklyPlan WeeklyPlan @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)
  meal       Meal       @relation(fields: [mealId], references: [id])
}

model ProgressPhoto {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  url       String
  notes     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
